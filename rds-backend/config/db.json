const express = require("express");
const router = express.Router();

const { loadDB, saveDBAsync } = require("../../config/db");

/* ================= HELPERS & VALIDATORS ================= */

function now() {
  return Date.now();
}

function num(v) {
  const parsed = Number(v);
  return isNaN(parsed) ? 0 : parsed;
}

function uid(prefix = "DRV") {
  return `${prefix}_${now()}_${Math.floor(Math.random() * 99999)}`;
}

function ok(res, payload = {}) {
  return res.status(200).json({ success: true, ...payload });
}

function fail(res, msg = "Error", code = 400) {
  return res.status(code).json({ success: false, error: msg });
}

/* ================= ROUTE HANDLERS ================= */

/* GET ALL DRIVERS (WITH OPTIONAL STATUS FILTERING) */
router.get("/", (req, res) => {
  try {
    const db = loadDB();
    const { status } = req.query;

    let list = Array.isArray(db.drivers) ? db.drivers : [];

    if (status) {
      const cleanStatus = status.toString().toLowerCase();
      list = list.filter(d => (d.status || "").toString().toLowerCase() === cleanStatus);
    }

    return ok(res, {
      count: list.length,
      data: list,
      drivers: list // Legacy support for various frontend panels
    });
  } catch (err) {
    return fail(res, "Failed to load drivers roster", 500);
  }
});

/* GET LIVE ACTIVE DRIVERS (SENDING TELEMETRY IN PAST 60 SECONDS) */
router.get("/live", (req, res) => {
  try {
    const db = loadDB();
    const currentTime = now();
    
    const active = (db.drivers || []).filter(d =>
      d.location &&
      d.lastSeen &&
      (currentTime - num(d.lastSeen) < 60000)
    );

    return ok(res, {
      count: active.length,
      data: active,
      drivers: active
    });
  } catch (err) {
    return fail(res, "Failed to load live driver map data", 500);
  }
});

/* GET SINGLE DRIVER BY ID */
router.get("/:id", (req, res) => {
  try {
    const db = loadDB();
    const driver = (db.drivers || []).find(d => d.id === req.params.id);

    if (!driver) {
      return fail(res, "Driver profile not found", 404);
    }

    return ok(res, { data: driver, driver });
  } catch (err) {
    return fail(res, "Failed to retrieve driver profile", 500);
  }
});

/* ADD / REGISTER DRIVER */
const addDriverHandler = (req, res) => {
  try {
    const db = loadDB();
    const name = (req.body.name || req.query.name || "").trim();
    const vehicle = (req.body.vehicle || req.query.vehicle || "N/A").trim();
    const phone = (req.body.phone || req.query.phone || "0700000000").trim();

    if (!name || name.length < 2) {
      return fail(res, "Driver name is required (minimum 2 characters)");
    }

    // Reactivate existing driver profile if duplicate name is registered
    let driver = (db.drivers || []).find(d => (d.name || "").toLowerCase() === name.toLowerCase());

    if (driver) {
      driver.status = "online";
      driver.lastSeen = now();
      driver.updatedAt = now();
      if (vehicle !== "N/A") driver.vehicle = vehicle;

      saveDBAsync(db);
      return ok(res, {
        message: "Existing driver profile reactivated",
        driver,
        data: driver
      });
    }

    driver = {
      id: uid("DRV"),
      name,
      phone,
      vehicle,
      status: "offline",
      earnings: 0,
      location: null,
      lastSeen: now(),
      createdAt: now(),
      updatedAt: now()
    };

    db.drivers.push(driver);
    saveDBAsync(db);

    return ok(res, {
      message: "Driver registered successfully",
      driver,
      data: driver
    });
  } catch (err) {
    return fail(res, "Failed to register driver", 500);
  }
};

router.post("/add", addDriverHandler);
router.post("/register", addDriverHandler); // Alias

/* UPDATE DRIVER STATUS */
const updateStatusHandler = (req, res) => {
  try {
    const db = loadDB();
    const driverId = req.body.driverId || req.body.id || req.query.driverId;
    let status = (req.body.status || req.query.status || "").toString().toLowerCase();

    if (!driverId || !status) {
      return fail(res, "Missing driverId or status payload");
    }

    if (["idle", "available", "online", "true"].includes(status)) {
      status = "online";
    }

    const driver = (db.drivers || []).find(d => d.id === driverId);
    if (!driver) {
      return fail(res, "Driver not found", 404);
    }

    driver.status = status;
    driver.lastSeen = now();
    driver.updatedAt = now();

    saveDBAsync(db);
    return ok(res, { message: "Driver status updated", driver, data: driver });
  } catch (err) {
    return fail(res, "Status update failed", 500);
  }
};

router.post("/status", updateStatusHandler);

/* UPDATE GPS TELEMETRY & LOCATION */
const updateLocationHandler = (req, res) => {
  try {
    const db = loadDB();
    const driverId = req.body.driverId || req.body.id || req.query.driverId;
    const payload = req.body.location || req.body;

    if (!driverId) {
      return fail(res, "Missing required driverId");
    }

    if (payload.lat == null || payload.lng == null) {
      return fail(res, "Missing valid latitude/longitude coordinates");
    }

    const latN = num(payload.lat);
    const lngN = num(payload.lng);

    if (isNaN(latN) || isNaN(lngN) || latN < -90 || latN > 90 || lngN < -180 || lngN > 180) {
      return fail(res, "Invalid geographical coordinate bounds");
    }

    const driver = (db.drivers || []).find(d => d.id === driverId);
    if (!driver) {
      return fail(res, "Driver not found", 404);
    }

    driver.location = {
      lat: latN,
      lng: lngN,
      heading: num(payload.heading),
      speed: num(payload.speed)
    };
    driver.status = "online";
    driver.lastSeen = now();
    driver.updatedAt = now();

    saveDBAsync(db);

    return ok(res, {
      message: "Location updated successfully",
      driver,
      location: driver.location
    });
  } catch (err) {
    return fail(res, "GPS telemetry update failed", 500);
  }
};

router.post("/location", updateLocationHandler);

/* DELETE DRIVER PROFILE */
router.delete("/:id", (req, res) => {
  try {
    const db = loadDB();
    const initialLength = db.drivers.length;

    db.drivers = db.drivers.filter(d => d.id !== req.params.id);

    if (db.drivers.length === initialLength) {
      return fail(res, "Driver profile not found", 404);
    }

    saveDBAsync(db);
    return ok(res, { message: `Driver ${req.params.id} deleted successfully` });
  } catch (err) {
    return fail(res, "Delete operation failed", 500);
  }
});

module.exports = router;